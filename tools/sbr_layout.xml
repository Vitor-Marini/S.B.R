<?xml version='1.0' encoding='UTF-8'?>
<root>
 <tabbed_widget name="Main Window" parent="main_window">
  <Tab tab_name="Equilibrio" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.25;0.25;0.25;0.25" count="4">
     <DockArea name="Angulo (graus): pitch filtrado x acelerometro">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="-5" top="15"/>
       <limitY/>
       <curve name="/acc" color="#c7c7c7"/>
       <curve name="/pitch" color="#1f77b4"/>
      </plot>
     </DockArea>
     <DockArea name="Controle: erro (graus) e aceleracao pedida (m/s2)">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="-5" top="5"/>
       <limitY/>
       <curve name="/err" color="#d62728"/>
       <curve name="/accel" color="#ff7f0e"/>
      </plot>
     </DockArea>
     <DockArea name="Velocidade: pedida (vtgt) x real (speed) em m/s, e inclinacao pedida (voff, graus)">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="-1" top="1"/>
       <limitY/>
       <curve name="/vtgt" color="#98df8a"/>
       <curve name="/speed" color="#2ca02c"/>
       <curve name="/voff" color="#9467bd"/>
      </plot>
     </DockArea>
     <DockArea name="Giro (graus/s): pitch (rate), yaw pedido (wtgt) x real (yrate)">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="-50" top="50"/>
       <limitY/>
       <curve name="/rate" color="#17becf"/>
       <curve name="/wtgt" color="#dbdb8d"/>
       <curve name="/yrate" color="#bcbd22"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <Tab tab_name="Saude" containers="1">
   <Container>
    <DockSplitter orientation="-" sizes="0.333;0.333;0.334" count="3">
     <DockArea name="Taxa do loop de controle (Hz, alvo 200)">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="150" top="210"/>
       <limitY/>
       <curve name="/tick" color="#1f77b4"/>
      </plot>
     </DockArea>
     <DockArea name="Estado (2 IDLE, 3 STARTING, 4 ACTIVE, 6 FAULT)">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="0" top="7"/>
       <limitY/>
       <curve name="/state" color="#d62728"/>
      </plot>
     </DockArea>
     <DockArea name="Gyro integrado x acelerometro (graus) e temperatura do MPU">
      <plot style="Lines" mode="TimeSeries" flip_x="false" flip_y="false">
       <range left="0" right="10" bottom="-20" top="60"/>
       <limitY/>
       <curve name="/gyroint" color="#9467bd"/>
       <curve name="/temp" color="#ff7f0e"/>
      </plot>
     </DockArea>
    </DockSplitter>
   </Container>
  </Tab>
  <currentTabIndex index="0"/>
 </tabbed_widget>
 <use_relative_time_offset enabled="1"/>
 <Plugins/>
 <previouslyLoaded_Datafiles/>
 <previouslyLoaded_Streamer name="UDP Server"/>
 <customMathEquations/>
 <snippets/>
</root>
